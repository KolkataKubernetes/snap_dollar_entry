summarise(
countyname = first(countyname),
type = first(type),
waiver_scope = if_else(
any(waiver_scope == "statewide", na.rm = TRUE),
"statewide",
"substate"
),
treatment = 1L,
.groups = "drop"
)
# ---- Merge treatment and retailer outcomes onto the balanced panel
county_names <- county |>
transmute(
county_fips = normalize_fips(county_fips),
countyname = county
) |>
distinct()
analysis_panel <- county_year_grid |>
left_join(
county_names,
by = "county_fips"
) |>
left_join(
entry_panel,
by = c("county_fips", "year")
) |>
left_join(
store_stock_panel,
by = c("county_fips", "year")
) |>
left_join(
waiver_treatment |>
select(-countyname),
by = c("county_fips", "year")
) |>
mutate(
treatment = replace_na(treatment, 0L),
waiver_scope = replace_na(waiver_scope, "none"),
across(
any_of(
c(
entry_outcome_columns,
"total_ds_entry",
stock_outcome_columns,
"total_count"
)
),
~ replace_na(.x, 0L)
)
)
# ---- Identify the first post-2014 waiver year
event2 <- analysis_panel |>
filter(
treatment == 1L,
year >= 2014L,
type == "County"
) |>
group_by(county_fips) |>
summarise(
eventYear2 = min(year),
.groups = "drop"
)
analysis_panel <- analysis_panel |>
left_join(
event2,
by = "county_fips"
) |>
mutate(
tau2 = year - eventYear2,
treated = !is.na(eventYear2)
)
rm(event2)
# ---- Add the fixed baseline covariates
analysis_panel <- analysis_panel |>
left_join(
county_covariates,
by = c("county_fips", "year")
) |>
arrange(
county_fips,
year
)
analysis_panel |>
arrange(county_fips, year) |>
group_by(county_fips) |>
summarise(
eventYear2 = first(eventYear2),
treatment_turns_off = if_else(
is.na(eventYear2),
FALSE,
any(year >= eventYear2 & treatment == 0L)
),
.groups = "drop"
) |>
count(treatment_turns_off)
library(fixest)
# ---- Construct the LPM event-study sample
# The existing LPM pipeline retains only counties that eventually receive a
# waiver and keeps, at most, the three years before first waiver exposure.
# Never-treated counties are therefore not part of this benchmark sample.
did_sample <- analysis_panel |>
mutate(
rent = rent / 1000,
medianInc = medianInc / 1000,
ds_entry_indicator = as.integer(total_ds_entry > 0),
chain_super_market_entry_indicator = as.integer(chain_super_market_entry > 0),
chain_convenience_store_entry_indicator = as.integer(chain_convenience_store_entry > 0),
chain_multi_category_entry_indicator = as.integer(chain_multi_category_entry > 0),
chain_medium_grocery_entry_indicator = as.integer(chain_medium_grocery_entry > 0),
chain_small_grocery_entry_indicator = as.integer(chain_small_grocery_entry > 0),
chain_produce_entry_indicator = as.integer(chain_produce_entry > 0),
chain_farmers_market_entry_indicator = as.integer(chain_farmers_market_entry > 0)
) |>
filter(
year %in% analysis_years,
!is.na(eventYear2),
tau2 >= -3,
!is.na(num_households),
!is.na(wage),
!is.na(medianInc),
!is.na(rent),
!is.na(urate)
)
did_sample |>
summarise(
observations = n(),
counties = n_distinct(county_fips),
first_year = min(year),
last_year = max(year)
)
# The regression formula below matches the existing LPM pipeline. In this QMD,
# however, the five covariates are fixed at their 2013 values and repeated over
# time. County fixed effects will therefore absorb them. The regression can be
# estimated, but its numerical result should not be expected to exactly match
# the existing pipeline, which uses time-varying covariates.
# ---- Dollar-store entry
did_total_ds <- feols(
ds_entry_indicator ~
sunab(eventYear2, year, ref.p = -1) +
num_households + wage + medianInc + rent + urate |
county_fips + year,
data = did_sample,
cluster = ~county_fips
)
# ---- Supermarket entry
did_super_market <- feols(
chain_super_market_entry_indicator ~
sunab(eventYear2, year, ref.p = -1) +
num_households + wage + medianInc + rent + urate |
county_fips + year,
data = did_sample,
cluster = ~county_fips
)
# ---- Convenience-store entry
did_convenience_store <- feols(
chain_convenience_store_entry_indicator ~
sunab(eventYear2, year, ref.p = -1) +
num_households + wage + medianInc + rent + urate |
county_fips + year,
data = did_sample,
cluster = ~county_fips
)
# ---- Multi-category-store entry
did_multi_category <- feols(
chain_multi_category_entry_indicator ~
sunab(eventYear2, year, ref.p = -1) +
num_households + wage + medianInc + rent + urate |
county_fips + year,
data = did_sample,
cluster = ~county_fips
)
# ---- Medium-grocery entry
did_medium_grocery <- feols(
chain_medium_grocery_entry_indicator ~
sunab(eventYear2, year, ref.p = -1) +
num_households + wage + medianInc + rent + urate |
county_fips + year,
data = did_sample,
cluster = ~county_fips
)
# ---- Small-grocery entry
did_small_grocery <- feols(
chain_small_grocery_entry_indicator ~
sunab(eventYear2, year, ref.p = -1) +
num_households + wage + medianInc + rent + urate |
county_fips + year,
data = did_sample,
cluster = ~county_fips
)
# ---- Produce-store entry
did_produce <- feols(
chain_produce_entry_indicator ~
sunab(eventYear2, year, ref.p = -1) +
num_households + wage + medianInc + rent + urate |
county_fips + year,
data = did_sample,
cluster = ~county_fips
)
# ---- Farmers-market entry
did_farmers_market <- feols(
chain_farmers_market_entry_indicator ~
sunab(eventYear2, year, ref.p = -1) +
num_households + wage + medianInc + rent + urate |
county_fips + year,
data = did_sample,
cluster = ~county_fips
)
# ---- Dynamic event-study plots
fixest::iplot(
did_total_ds,
main = "Dollar-store entry",
xlab = "Years relative to first waiver exposure",
ylab = "Estimated treatment effect",
ref.line = 0
)
fixest::iplot(
did_convenience_store,
main = "Convenience-store entry",
xlab = "Years relative to first waiver exposure",
ylab = "Estimated treatment effect",
ref.line = 0
)
# ---- Compare the average post-treatment effects across outcomes
etable(
did_total_ds,
did_super_market,
did_convenience_store,
did_multi_category,
did_medium_grocery,
did_small_grocery,
did_produce,
did_farmers_market,
headers = c(
"Dollar Stores",
"Supermarkets",
"Convenience Stores",
"Multi Category",
"Medium Grocery",
"Small Grocery",
"Produce",
"Farmers Market"
),
agg = "att",
keep = "ATT"
)
library(did)
library(ggplot2)
# ---- Construct the Callaway-Sant'Anna sample
cs_sample <- analysis_panel |>
mutate(
county_id = as.integer(county_fips),
first_treat_year = if_else(
is.na(eventYear2),
0L,
eventYear2
),
ds_entry_indicator = as.integer(total_ds_entry > 0),
chain_convenience_store_entry_indicator = as.integer(
chain_convenience_store_entry > 0
),
medianInc = medianInc / 1000,
rent = rent / 1000
) |>
filter(
year %in% analysis_years,
!is.na(num_households),
!is.na(wage),
!is.na(medianInc),
!is.na(rent),
!is.na(urate)
)
# Show the number of counties in each first-treatment cohort before applying
# the first-period restriction.
cs_sample |>
distinct(
county_id,
first_treat_year
) |>
count(
first_treat_year,
name = "counties"
)
# Because 2014 is the first observed year, counties first treated in 2014 have
# no pre-treatment observation. The `did` package drops these already-treated
# counties. Make that restriction explicit while retaining 2014 as the first
# observation for never-treated counties and counties treated in 2015 or later.
#cs_sample <- cs_sample |>
#  filter(
#    first_treat_year == 0L |
#      first_treat_year > 2014L
#  )
# Verify that the retained county panel remains balanced.
cs_sample |>
count(
county_id,
name = "years_observed"
) |>
count(
years_observed,
name = "counties"
)
# ---- Dollar-store entry
cs_dollar_stores <- did::att_gt(
yname = "ds_entry_indicator",
tname = "year",
idname = "county_id",
gname = "first_treat_year",
xformla = ~
num_households +
wage +
medianInc +
rent,
# urate,
data = cs_sample,
panel = TRUE,
control_group = "notyettreated",
est_method = "dr",
base_period = "universal",
allow_unbalanced_panel = FALSE,
bstrap = FALSE,
cband = FALSE
)
cs_dollar_stores_event <- did::aggte(
cs_dollar_stores,
type = "dynamic",
min_e = -3,
max_e = 5,
na.rm = TRUE,
bstrap = FALSE,
cband = FALSE
)
summary(cs_dollar_stores_event)
cs_dollar_stores_plot <- did::ggdid(
cs_dollar_stores_event
) +
labs(
title = "Dollar-store entry indicator",
subtitle = "Callaway-Sant'Anna event study",
x = "Years relative to first waiver exposure",
y = "Average treatment effect"
) +
theme_minimal()
cs_dollar_stores_plot
# ---- Convenience-store entry
cs_convenience_stores <- did::att_gt(
yname = "chain_convenience_store_entry_indicator",
tname = "year",
idname = "county_id",
gname = "first_treat_year",
xformla = ~
num_households +
wage +
medianInc +
rent,
#  urate,
data = cs_sample,
panel = TRUE,
control_group = "notyettreated",
est_method = "dr",
base_period = "universal",
allow_unbalanced_panel = FALSE,
bstrap = FALSE,
cband = FALSE
)
cs_convenience_stores_event <- did::aggte(
cs_convenience_stores,
type = "dynamic",
min_e = -3,
max_e = 5,
na.rm = TRUE,
bstrap = FALSE,
cband = FALSE
)
summary(cs_convenience_stores_event)
cs_convenience_stores_plot <- did::ggdid(
cs_convenience_stores_event
) +
labs(
title = "Convenience-store entry indicator",
subtitle = "Callaway-Sant'Anna event study",
x = "Years relative to first waiver exposure",
y = "Average treatment effect"
) +
theme_minimal()
cs_convenience_stores_plot
library('etwfe')
poisson_sample <- cs_sample |>
filter(
first_treat_year == 0L |
first_treat_year > 2014L
)
dollar_poisson_extensive <- etwfe(
fml = ds_entry_indicator ~ num_households + wage + medianInc + rent,
tvar = year,
gvar = first_treat_year,
data = poisson_sample,
cgroup = "notyet",
family = "poisson",
vcov = ~county_id
)
dollar_poisson_att_extensive <- emfx(
dollar_poisson_extensive,
type = "simple",
predict = "response"
)
dollar_poisson_att_extensive
dollar_poisson_event_extensive <- emfx(
dollar_poisson_extensive,
type = "event",
predict = "response",
post_only = TRUE
)
dollar_poisson_event_extensive
plot(dollar_poisson_event_extensive)
convenience_poisson_extensive <- etwfe(
fml = chain_convenience_store_entry_indicator ~ num_households + wage + medianInc + rent,
tvar = year,
gvar = first_treat_year,
data = poisson_sample,
cgroup = "notyet",
family = "poisson",
vcov = ~county_id
)
convenience_poisson_att_extensive <- emfx(
convenience_poisson_extensive,
type = "simple",
predict = "response"
)
convenience_poisson_att_extensive
convenience_poisson_event_extensive <- emfx(
convenience_poisson_extensive,
type = "event",
predict = "response",
post = FALSE
)
convenience_poisson_event_extensive
plot(convenience_poisson_event_extensive )
dollar_poisson_intensive <- etwfe(
fml = total_ds_entry ~ num_households + wage + medianInc + rent,
tvar = year,
gvar = first_treat_year,
data = poisson_sample,
cgroup = "notyet",
family = "poisson",
vcov = ~county_id
)
dollar_poisson_att_intensive <- emfx(
dollar_poisson_intensive,
type = "simple",
predict = "response"
)
dollar_poisson_att_intensive
dollar_poisson_event_intensive <- emfx(
dollar_poisson_intensive,
type = "event",
predict = "response"
)
dollar_poisson_event_intensive
plot(dollar_poisson_event_intensive)
convenience_poisson <- etwfe(
fml = chain_convenience_store_entry ~ num_households + wage + medianInc + rent,
tvar = year,
gvar = first_treat_year,
data = poisson_sample,
cgroup = "notyet",
family = "poisson",
vcov = ~county_id
)
convenience_poisson_att <- emfx(
convenience_poisson,
type = "simple",
predict = "response"
)
convenience_poisson_att
convenience_poisson_event <- emfx(
convenience_poisson,
type = "event",
predict = "response"
)
convenience_poisson_event
plot(convenience_poisson_event)
repeated_record_dates <- snap |>
filter(
!is.na(`Record ID`),
!is.na(`Authorization Date`)
) |>
group_by(`Record ID`) |>
filter(
n_distinct(`Authorization Date`) > 1
) |>
mutate(
number_of_authorization_dates = n_distinct(`Authorization Date`)
) |>
ungroup() |>
arrange(
desc(number_of_authorization_dates),
`Record ID`,
`Authorization Date`
) |>
select(
`Record ID`,
`Store Name`,
`Store Type`,
County,
State,
`Authorization Date`,
`End Date`,
number_of_authorization_dates
)
repeated_record_dates
gc()
